# Kather Baksho backend environment variables
# Copy this file to backend/.env and fill in real values.
# .env is git-ignored.

# ---------- Auth ----------
# HMAC signing key for JWTs. Required when GIN_MODE=release (the server will
# refuse to start without it). Falls back to an insecure dev default otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# ---------- Mail (Brevo, free tier — 300 emails/day, no credit card) ----------
# Get a key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Anything you control works — must be a sender verified in Brevo.
# The default below is enough for local dev (Brevo will silently accept).
MAIL_FROM_EMAIL=no-reply@kather_baksho.local
MAIL_FROM_NAME=Kather Baksho
