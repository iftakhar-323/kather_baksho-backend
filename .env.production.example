# =====================================================================
# KATHER BAKSHO BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env on your VPS and configure with real secrets.
# =====================================================================

# Security & Secrets
JWT_SECRET=super_secure_random_production_jwt_secret_change_me_now!

# Allowed Frontend Origins for CORS (e.g. Vercel / Netlify / Custom Domain)
ALLOWED_ORIGINS=https://katherbaksho.com,https://your-frontend.vercel.app

# Public Domain & Automated Let's Encrypt SSL
DOMAIN_NAME=api.katherbaksho.com
ACME_EMAIL=admin@katherbaksho.com

# MinIO S3 Object Storage Credentials
MINIO_ROOT_USER=kather_baksho_admin
MINIO_ROOT_PASSWORD=kather_baksho_secret_key_prod_123

# Email Notifications (Brevo / Sendinblue SMTP or API)
BREVO_API_KEY=xkeysib-your-real-brevo-api-key-here
BREVO_SENDER_EMAIL=support@katherbaksho.com

# Payment Gateways (Leave empty for simulated/mock testing)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_IS_SANDBOX=true

# SMS Notifications (Greenweb or Twilio)
SMS_PROVIDER=logger
GREENWEB_SMS_TOKEN=
